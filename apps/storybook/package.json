{
  "name": "parya-designsystem-storybook",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "sync": "node scripts/generate-stories.mjs",
    "storybook": "npm run sync && storybook dev -p 6008 --host 127.0.0.1 --no-open --disable-telemetry",
    "build": "npm run sync && storybook build --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6008 --strictPort",
    "test": "playwright test"
  },
  "dependencies": {
    "@parya/design-system": "0.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-a11y": "10.6.5",
    "storybook": "10.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
