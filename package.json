{
  "name": "@parya/design-system",
  "version": "0.3.1",
  "description": "Parya React design system, built from the Paryatech Paper library",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "AGENTS.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./catalog.json": "./dist/catalog.json",
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js"
    }
  },
  "scripts": {
    "dev": "node scripts/build-fonts.mjs && node scripts/generate-docs.mjs && vite --config site/vite.config.ts --host 127.0.0.1 --port 5190 --strictPort",
    "build": "npm run build:lib && npm run build:docs",
    "build:lib": "node scripts/build-fonts.mjs && node scripts/generate-docs.mjs && vite build && tsc -p tsconfig.lib.json && node scripts/build-library.mjs",
    "build:docs": "node scripts/generate-docs.mjs && vite build --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/onest": "^5.2.0",
    "@fontsource-variable/public-sans": "^5.2.0",
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yakosasam797/parya.designsystem.code.git"
  },
  "engines": {
    "node": ">=22.12"
  }
}
