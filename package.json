{
  "description": "Parya React design system, built from the Paryatech Paper library",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "name": "parya-design-system-workspace",
  "private": true,
  "version": "0.3.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:docs": "npm run generate && vite --config apps/docs/vite.config.ts --host 127.0.0.1 --port 5190 --strictPort",
    "dev:storybook": "npm run generate && npm run storybook --workspace parya-designsystem-storybook",
    "generate": "node scripts/build-fonts.mjs && node scripts/generate-docs.mjs",
    "build": "npm run build:lib && npm run build:docs && npm run build:storybook",
    "build:lib": "npm run generate && vite build --config packages/web/vite.config.ts && tsc -p packages/web/tsconfig.lib.json && node scripts/build-library.mjs",
    "build:docs": "npm run generate && vite build --config apps/docs/vite.config.ts",
    "build:storybook": "npm run build --workspace parya-designsystem-storybook",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace parya-designsystem-storybook",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:storybook": "npm test --workspace parya-designsystem-storybook --",
    "test:package": "npm run build:lib && node scripts/verify-package.mjs",
    "pack:lib": "npm pack --workspace @parya/design-system",
    "prepare": "npm run build:lib",
    "serve:docs": "vite --config apps/docs/vite.config.ts --host 127.0.0.1 --port 5190 --strictPort"
  }
}
